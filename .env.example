# 서울 열린데이터광장 (data.seoul.go.kr) OpenAPI 인증키
# - 생활인구, 공영주차장 안내정보, 시영주차장 실시간 주차대수, 등록차량 현황
SEOUL_OPENAPI_KEY= 

# 카카오 REST API 키 (https://developers.kakao.com) - 로컬 API로 POI(음식점/카페/문화시설) 수집
KAKAO_REST_API_KEY=

# SGIS 통계지리정보서비스 (행정동 경계) - https://sgis.kostat.go.kr
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 공공데이터포털 (data.go.kr) 인증키 - 예비
DATA_GO_KR_KEY=